# KPI Dashboard - Environment Configuration Template
# Copy this file to .env and configure for your environment

# ============================================================================
# Application Settings
# ============================================================================

# Application Environment
# Options: development, staging, production
APP_ENV=production

# Debug Mode
# Set to false in production
APP_DEBUG=false

# Application URL
# Your WordPress site URL
APP_URL=https://yourdomain.com

# ============================================================================
# Database Configuration
# ============================================================================

# Note: WordPress database settings are in wp-config.php
# These are optional overrides for KPI Dashboard specific settings

# Database Table Prefix (from WordPress)
# DB_PREFIX=wp_

# ============================================================================
# JWT Authentication
# ============================================================================

# JWT Secret Key
# Generate a secure random key: openssl rand -base64 32
# If not set, plugin will generate one on activation
JWT_SECRET=your-256-bit-secret-key-here

# JWT Access Token Expiration (in seconds)
# Default: 900 (15 minutes)
JWT_ACCESS_EXPIRY=900

# JWT Refresh Token Expiration (in seconds)
# Default: 604800 (7 days)
JWT_REFRESH_EXPIRY=604800

# ============================================================================
# Email Configuration
# ============================================================================

# Email From Address
# Used for system emails
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# Email From Name
MAIL_FROM_NAME="KPI Dashboard"

# SMTP Configuration (if using external SMTP)
# Leave empty to use WordPress default mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# ============================================================================
# Company Branding
# ============================================================================

# Company Name
COMPANY_NAME="MBD Corp"

# Company Logo URL
COMPANY_LOGO=https://www.mbdcorp.id/wp-content/uploads/2022/08/logo-favicon-mbd-corp-150x150-1.webp

# Primary Brand Color (hex)
PRIMARY_COLOR=#1565C0

# Secondary Brand Color (hex)
SECONDARY_COLOR=#FF6B35

# ============================================================================
# System Configuration
# ============================================================================

# Data Retention Period (in years)
# How long to keep historical data
DATA_RETENTION_YEARS=3

# Pagination - Items per page
ITEMS_PER_PAGE=20

# Maximum items per page (for API requests)
MAX_ITEMS_PER_PAGE=100

# Upload Max File Size (in MB)
UPLOAD_MAX_SIZE=10

# ============================================================================
# Logging
# ============================================================================

# Log Level
# Options: ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=ERROR

# Log File Path
# Relative to plugin directory
LOG_PATH=logs

# Log Rotation
# Keep logs for how many days
LOG_RETENTION_DAYS=30

# ============================================================================
# Cache Configuration
# ============================================================================

# Cache Driver
# Options: transient (WordPress), redis, memcached
CACHE_DRIVER=transient

# Cache TTL (in seconds)
# Default: 3600 (1 hour)
CACHE_TTL=3600

# Redis Configuration (if using Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================================================
# API Configuration
# ============================================================================

# API Rate Limiting
# Enable rate limiting for API requests
API_RATE_LIMIT_ENABLED=true

# API Rate Limit
# Requests per hour for authenticated users
API_RATE_LIMIT=300

# API Rate Limit (Anonymous)
# Requests per hour for non-authenticated requests
API_RATE_LIMIT_ANONYMOUS=60

# API Timeout (in seconds)
API_TIMEOUT=30

# ============================================================================
# Notification Settings
# ============================================================================

# Email Notifications Enabled
NOTIFICATIONS_EMAIL_ENABLED=true

# In-App Notifications Enabled
NOTIFICATIONS_INAPP_ENABLED=true

# Notification Digest
# Send daily/weekly digest emails
NOTIFICATION_DIGEST_ENABLED=false
NOTIFICATION_DIGEST_FREQUENCY=weekly

# ============================================================================
# Security Settings
# ============================================================================

# Session Timeout (in seconds)
# Default: 3600 (1 hour)
SESSION_TIMEOUT=3600

# Max Login Attempts
# Before account lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout Duration (in seconds)
# Default: 900 (15 minutes)
LOCKOUT_DURATION=900

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# ============================================================================
# Development Settings
# ============================================================================

# Vite Dev Server URL (for development)
# Used when APP_ENV=development
VITE_DEV_SERVER=http://localhost:5173

# Enable Hot Module Replacement
VITE_HMR_ENABLED=true

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable specific features

# Dummy Data Generator
FEATURE_DUMMY_DATA=true

# Advanced Analytics
FEATURE_ANALYTICS=true

# Report Generation
FEATURE_REPORTS=true

# Email Notifications
FEATURE_EMAIL_NOTIFICATIONS=true

# File Attachments
FEATURE_ATTACHMENTS=true

# Comments & Collaboration
FEATURE_COMMENTS=true

# Dark Mode
FEATURE_DARK_MODE=true

# ============================================================================
# Third-Party Integrations
# ============================================================================

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=

# ============================================================================
# Backup Configuration
# ============================================================================

# Automated Backups
BACKUP_ENABLED=false

# Backup Frequency
# Options: daily, weekly, monthly
BACKUP_FREQUENCY=weekly

# Backup Retention (number of backups to keep)
BACKUP_RETENTION=4

# Backup Path
BACKUP_PATH=/backups

# ============================================================================
# Advanced Settings
# ============================================================================

# Database Query Logging
# Enable to log slow queries (development only)
DB_QUERY_LOG=false

# Slow Query Threshold (in seconds)
SLOW_QUERY_THRESHOLD=1.0

# Debug SQL Queries
DEBUG_SQL=false

# Asset Versioning
# Append version to CSS/JS files for cache busting
ASSET_VERSION=1.0.0

# CDN URL (if using CDN for assets)
CDN_URL=

# ============================================================================
# Notes
# ============================================================================

# 1. This file should NOT be committed to version control
# 2. Add .env to .gitignore
# 3. Each environment should have its own .env file
# 4. Generate secure random values for secrets
# 5. In production, set APP_DEBUG=false
# 6. Review and adjust settings based on your needs
# 7. Some settings can be overridden in wp-config.php
# 8. WordPress settings take precedence over these values

# ============================================================================
# Generate Secure Keys
# ============================================================================

# Use these commands to generate secure random keys:
#
# JWT Secret:
#   openssl rand -base64 32
#
# Random String (32 chars):
#   openssl rand -hex 16
#
# UUID:
#   uuidgen (on macOS/Linux)
#   Or use online generator

# ============================================================================
# WordPress Integration
# ============================================================================

# Most database and core WordPress settings are in wp-config.php
# This .env file is specifically for KPI Dashboard plugin configuration
#
# To use these settings, add to wp-config.php:
#
# // Load KPI Dashboard environment variables
# if (file_exists(__DIR__ . '/wp-content/plugins/kpi-dashboard/.env')) {
#     $dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/wp-content/plugins/kpi-dashboard');
#     $dotenv->load();
# }
#
# Or set directly in wp-config.php:
#
# define('KPI_DASHBOARD_JWT_SECRET', 'your-secret-here');
# define('KPI_DASHBOARD_LOG_LEVEL', 'ERROR');
# define('KPI_DASHBOARD_CACHE_TTL', 3600);

# ============================================================================
